# Contact form delivery
#
# Copy this file to `.env.local` for development, and set the same values in
# your host's dashboard for production (Vercel: Settings → Environment
# Variables). Without RESEND_API_KEY the contact form returns a clear
# "not connected yet" notice instead of pretending a message was delivered.

# From https://resend.com — create a key, it starts with "re_".
RESEND_API_KEY=

# Where enquiries land. Defaults to `site.email` in data/site.ts if unset.
CONTACT_TO=AlhutchinsonAPRN@outlook.com

# The From address. Resend requires the sending domain to be verified before
# it will accept mail from it. Until alhutchinsondigital.com is verified, use
# the shared testing sender below — it only delivers to your own account email.
#
#   Testing:    Al Hutchinson Digital <onboarding@resend.dev>
#   Production: Al Hutchinson Digital <hello@alhutchinsondigital.com>
CONTACT_FROM=Al Hutchinson Digital <onboarding@resend.dev>
