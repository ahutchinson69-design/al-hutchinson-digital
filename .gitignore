# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env*
# ...but DO commit the template, which holds only variable names.
!.env.example

# The full CV is marked CONFIDENTIAL. It is already kept out of `public/` so it
# is never deployed — this keeps it out of git history too, which matters if
# this repository is ever made public. The file stays on disk at assets/cv/;
# it simply is not version-controlled. The one-page public résumé under
# public/resume/ IS committed and IS meant to be downloadable.
/assets/cv/

# vercel
.vercel

# isolated feature worktrees
.worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts
